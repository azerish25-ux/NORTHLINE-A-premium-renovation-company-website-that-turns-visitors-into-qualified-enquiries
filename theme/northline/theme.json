{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "760px", "wideSize": "1480px" },
    "color": { "defaultPalette": false, "palette": [
      { "slug": "limestone", "name": "Limestone", "color": "#f3f0e9" },
      { "slug": "forest", "name": "Deep olive", "color": "#283229" },
      { "slug": "clay", "name": "Burnt clay", "color": "#af543c" },
      { "slug": "sage", "name": "Muted sage", "color": "#646c60" },
      { "slug": "line", "name": "Drawing line", "color": "#cbc7bd" },
      { "slug": "paper", "name": "Warm paper", "color": "#fcfaf5" }
    ] },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        { "slug": "sans", "name": "Studio Sans", "fontFamily": "Arial, Helvetica, sans-serif" },
        { "slug": "serif", "name": "Editorial Serif", "fontFamily": "Georgia, 'Times New Roman', serif" },
        { "slug": "mono", "name": "Drawing Notes", "fontFamily": "'Courier New', ui-monospace, monospace" }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Annotation", "size": "0.8125rem" },
        { "slug": "medium", "name": "Body", "size": "1.0625rem" },
        { "slug": "large", "name": "Lead", "size": "1.375rem" },
        { "slug": "x-large", "name": "Section", "size": "3.75rem", "fluid": { "min": "2.5rem", "max": "3.75rem" } },
        { "slug": "xx-large", "name": "Display", "size": "7rem", "fluid": { "min": "3.25rem", "max": "7rem" } }
      ]
    },
    "spacing": { "units": ["px", "rem", "vw", "%"], "spacingSizes": [
      { "slug": "20", "name": "Tight", "size": "0.75rem" },
      { "slug": "40", "name": "Standard", "size": "1.5rem" },
      { "slug": "60", "name": "Room", "size": "3rem" },
      { "slug": "80", "name": "Section", "size": "7rem" }
    ] }
  },
  "styles": {
    "color": { "background": "var:preset|color|limestone", "text": "var:preset|color|forest" },
    "typography": { "fontFamily": "var:preset|font-family|sans", "fontSize": "var:preset|font-size|medium", "lineHeight": "1.65" },
    "spacing": { "blockGap": "1.5rem" },
    "elements": {
      "heading": { "typography": { "fontFamily": "var:preset|font-family|serif", "fontWeight": "400", "lineHeight": "1.08", "letterSpacing": "-0.045em" } },
      "link": { "color": { "text": "var:preset|color|forest" } },
      "button": { "color": { "background": "var:preset|color|forest", "text": "var:preset|color|limestone" }, "border": { "radius": "0" }, "typography": { "fontSize": "0.9375rem", "fontWeight": "400" }, "spacing": { "padding": { "top": "1rem", "bottom": "1rem", "left": "1.5rem", "right": "1.5rem" } } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "NORTHLINE header", "area": "header" },
    { "name": "footer", "title": "NORTHLINE footer", "area": "footer" }
  ]
}
